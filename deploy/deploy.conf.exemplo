# Configuração do deploy — copie para deploy.conf e ajuste.
#
#   cp deploy.conf.exemplo deploy.conf
#   chmod 600 deploy.conf
#
# Este arquivo NÃO guarda segredo nenhum.
#
# O repositório é público: o servidor lê por HTTPS sem credencial alguma.
# Se um dia ele virar privado, troque para SSH com chave de deploy
# (veja DEPLOY.md) — nunca use https:// com token embutido na URL.
REPO="https://github.com/sidneyalpagel/sendmail.git"

# O que publicar: um branch (main) ou uma tag (v1.0.0).
# Em produção, prefira tag — assim você sabe exatamente o que está no ar.
REFERENCIA="v1.2.2"

# Onde a aplicação roda
DESTINO="/home/informatica/web/sendmail.santahelena.pr.gov.br"
USUARIO="informatica"
GRUPO="informatica"

# Área de trabalho do deploy (cópia do repositório e backups)
TRABALHO="/opt/sendmail-deploy"

# Quantos backups manter
MANTER_BACKUPS=5

# Caminho do PHP
PHP="/usr/bin/php"

# Apelido da chave de deploy configurada em ~/.ssh/config, usado apenas
# com REPO por SSH (deixe vazio com repositório público por HTTPS)
HOST_SSH=""
